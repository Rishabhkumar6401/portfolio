# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# --- Supabase (safe to be public: Row Level Security protects the data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Resend (SECRET — never commit, never prefix with NEXT_PUBLIC_) ---
# Free plan, no domain needed: resend.com → API Keys → Create.
RESEND_API_KEY=
# Where new contact messages are delivered. On the free plan without a domain,
# this must be the same email you signed up to Resend with.
CONTACT_TO_EMAIL=

# --- Upstash Redis for the webhook tester and the cache test (SECRET token — never prefix with NEXT_PUBLIC_) ---
# Free plan, no card: console.upstash.com → Create Database → region AWS ap-northeast-1 (Tokyo),
# the same region as the Supabase project, then copy the REST URL and token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: the site's public address, once it moves to its own domain (no trailing slash) ---
# Used for the sitemap, canonical links and link previews. Defaults to https://rishabh-kumar.vercel.app.
# NEXT_PUBLIC_SITE_URL=

# --- Random secrets (generate with: openssl rand -hex 32) ---
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Salt for hashing visitor IPs (used only for rate limiting).
IP_HASH_SALT=
