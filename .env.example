# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# --- Supabase (safe to be public: Row Level Security protects the data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Brevo (SECRET — never commit, never prefix with NEXT_PUBLIC_) ---
BREVO_API_KEY=
# Must be a sender address verified in Brevo → Senders & IP.
BREVO_SENDER_EMAIL=
# Where new contact messages are delivered.
CONTACT_TO_EMAIL=

# --- Random secrets (generate with: openssl rand -hex 32) ---
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Salt for hashing visitor IPs (used only for rate limiting).
IP_HASH_SALT=
